# ==================================================
# SECURITY-FOCUSED .gitignore — テンプレート
#
# 必要なファイルは !パターン でホワイトリストに追加してください。
# シークレットスキャンツール（gitleaks / truffleHog 等）との併用を強く推奨します。
# ==================================================

# ==================================================
# 環境変数・dotenv
# ==================================================
.env
.env.*          # .env.local / .env.ci / .env.test 等を包括
*.local         # application.local 等も包括（.env.local も含む）
.envrc

# ホワイトリスト候補（必要なプロジェクトでコメント解除）
# !.env.example
# !.env.sample
# !*.sql
# !*.csv
# !*.tsv

# ==================================================
# 証明書・秘密鍵
# ==================================================
*.pem           # *-key.pem / *-cert.pem / localhost.pem 等を包括
*.key
*.p12
*.pfx
*.cer
*.cert          # cloudflared.cert 等を包括
*.crt
*.csr
*.certSigningRequest
*.der
*.rsa
*.ppk
*.p8
*.pkcs12
*.priv
*.private
*.secret
*.ca-bundle
*.p7b
*.p7c
*.spc
*.agekey
age-key.txt
keys.txt
git-crypt-key
*.bcfks         # Bouncy Castle キーストア

# SSH キー（id_rsa 等は *_rsa に包括される）
*_rsa
*_dsa
*_ecdsa
*_ed25519
*.pub           # ※リポジトリで公開鍵を管理する明確な意図がない限り除外推奨

# GPG
*.gpg
*.asc
secring.gpg

# キーストア
*.keystore
*.jks
*.kdb
*.jceks
*.bks
truststore.jks

# iOS プロビジョニング・ビルド署名
*.mobileprovision
*.developerprofile
*.mobileconfig  # Apple 構成プロファイル
key.properties
keystore.properties
signing.properties
manifest.key

# VPN・ネットワーク設定
*.ovpn
*.tblk
*.visc          # Viscosity VPN プロファイル
*.conf          # WireGuard 等（nginx.conf 等と衝突する場合は wg*.conf など明示的に指定を推奨）
*.pcf           # Cisco VPN
*.vnc           # VNC 接続プロファイル（パスワードハッシュ含む）
*.rdp           # RDP ファイル（ログイン資格情報が保存されていることがある）
ngrok.yml

# ==================================================
# パスワードマネージャー・Vault
# ==================================================
*.vault
vault_pass*
*.kdbx
1Password/
.vault-token
bw_session      # Bitwarden CLI セッションファイル

